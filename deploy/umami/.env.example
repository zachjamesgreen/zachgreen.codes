# The secrets deploy/umami/compose.yaml reads, as /srv/umami/.env on the server (root, 600).
# deploy/setup-umami.sh writes that file once, with `openssl rand -hex 32` for each value,
# and never again: a new POSTGRES_PASSWORD would no longer open the existing database.
# Never commit the real file. Hex values are URL-safe, which the password has to be,
# because it sits inside DATABASE_URL.

# The database password, for Postgres and inside Umami's DATABASE_URL.
POSTGRES_PASSWORD=<64 hex digits>
# Signs Umami's login tokens.
APP_SECRET=<64 hex digits>
# Encrypts the secrets of two-factor logins (exactly 64 hex digits).
TWO_FACTOR_ENCRYPTION_KEY=<64 hex digits>
