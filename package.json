{
  "name": "zachgreen-codes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "node scripts/serve.ts --root site --port 4321",
    "resume:pdf": "node scripts/resume-pdf.ts",
    "lint": "html-validate site tests/e2e/fixtures && stylelint \"site/css/**/*.css\" && tsc && node scripts/check-no-fonts.ts && node scripts/check-content.ts",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:nginx": "node --test tests/nginx/nginx.test.ts",
    "check": "pnpm lint && pnpm test:unit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capsizecss/unpack": "4.0.1",
    "@playwright/test": "1.64.1",
    "@types/culori": "4.0.1",
    "@types/node": "24.19.2",
    "culori": "4.0.2",
    "fontkitten": "1.0.3",
    "html-validate": "11.17.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "undici": "8.12.3",
    "unpdf": "1.9.1"
  }
}
