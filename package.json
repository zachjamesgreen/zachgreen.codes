{
  "name": "zachgreen-codes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "node scripts/serve.ts --root site --port 4321",
    "lint": "html-validate site && stylelint \"site/css/**/*.css\" --allow-empty-input && tsc && node scripts/check-no-fonts.ts && node scripts/check-content.ts",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "check": "pnpm lint && pnpm test:unit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "html-validate": "11.17.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2"
  }
}
